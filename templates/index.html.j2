<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow,noarchive">
<title>{{ page.title }} — kod</title>
<style>
{% include "base.css" %}

.wrap {
  max-width: 32rem;
  margin: 0 auto;
  padding: clamp(2.5rem, 8vw, 6rem) clamp(1.25rem, 5vw, 2rem) 3.5rem;
}

h1 {
  margin: 1.1rem 0 0;
  font-family: var(--serif);
  font-weight: 500;
  font-size: clamp(2rem, 7vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.03em;
  text-wrap: balance;
}

.lead {
  margin: 1.4rem 0 0;
  font-size: 1.02rem;
  line-height: 1.65;
  color: #2f3437;
  text-wrap: pretty;
}

.ticket {
  margin: 2.75rem 0 0;
  padding: clamp(1.75rem, 6vw, 2.5rem);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  text-align: center;
  transition: box-shadow 200ms ease;
}
.ticket:hover { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04); }

.qr { width: min(15rem, 62vw); margin: 0 auto; }
.qr svg { display: block; width: 100%; height: auto; }

.code {
  margin: 1.6rem 0 0;
  font-family: var(--mono);
  font-size: 1.05rem;
  letter-spacing: 0.14em;
}

.note {
  margin: 0.8rem auto 0;
  max-width: 26ch;
  font-size: 0.82rem;
  line-height: 1.55;
  color: var(--muted);
}

.meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem 1.1rem;
  margin: 1.9rem 0 0;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}
.meta span + span::before { content: "·"; margin-right: 1.1rem; }

.foot {
  margin: 2.5rem 0 0;
  font-size: 0.86rem;
  line-height: 1.65;
  color: var(--muted);
}

.notice {
  margin: 2rem 0 0;
  padding: 0.72rem 0.9rem;
  background: var(--note-bg);
  color: var(--note-ink);
  border-radius: 6px;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
}

.rise {
  animation: rise 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(var(--i, 0) * 90ms);
}
@keyframes rise { from { opacity: 0; transform: translateY(12px); } }
@media (prefers-reduced-motion: reduce) { .rise { animation: none; } }
</style>
</head>
<body>
<main class="wrap">
  <header>
    <p class="eyebrow rise" style="--i:0">{{ page.title }}</p>
    <h1 class="rise" style="--i:0">{{ gift.headline }}</h1>
    <p class="lead rise" style="--i:1">{{ gift.lead }}</p>
  </header>

  <section class="ticket rise" style="--i:2">
    <div class="qr">{{ qr_svg | safe }}</div>
    <p class="code">{{ voucher.code }}</p>
    <p class="note">{{ voucher.note }}</p>
  </section>

  <p class="meta rise" style="--i:3">
    {% for item in gift.meta %}<span>{{ item }}</span>{% endfor %}
  </p>

  <p class="foot rise" style="--i:4">
    Rezerwacja online: <a href="{{ voucher.redeem_url }}" rel="noreferrer">lock.me</a>.
    Kod jest jednorazowy — nie wysyłaj go dalej.
  </p>

  {% if page.test_mode %}
  <p class="notice rise" style="--i:5">Wersja testowa — kupon jest zastępczy</p>
  {% endif %}
</main>
</body>
</html>
