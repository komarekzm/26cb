<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow,noarchive">
<title>{{ page.title }} — zagadka</title>
<style>
{% include "base.css" %}

.wrap {
  max-width: 34rem;
  margin: 0 auto;
  padding: clamp(2.5rem, 8vw, 5rem) clamp(1.25rem, 5vw, 2rem) 3.5rem;
}

h1 {
  margin: 1.1rem 0 0;
  font-family: var(--serif);
  font-weight: 500;
  font-size: clamp(2rem, 7vw, 2.7rem);
  line-height: 1.05;
  letter-spacing: -0.03em;
  text-wrap: balance;
}

.lead {
  margin: 1.4rem 0 0;
  font-size: 1.02rem;
  line-height: 1.65;
  color: #2f3437;
  text-wrap: pretty;
}

.puzzle {
  margin-top: 2.5rem;
  padding: clamp(1.4rem, 5vw, 2rem);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
}
.puzzle .step:first-of-type { margin-top: 0.4rem; }

.clues {
  margin: 0.6rem 0 0;
  padding: 0;
  list-style: none;
  counter-reset: clue;
}
.clues li {
  display: flex;
  gap: 0.7rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--line);
  line-height: 1.55;
}
.clues li:last-child { border-bottom: 0; }
.clues .num {
  flex: none;
  width: 1.1rem;
  font-family: var(--mono);
  font-size: 0.78rem;
  color: var(--muted);
  text-align: right;
  padding-top: 0.15rem;
}
.clues .clue { font-size: 0.95rem; color: #2f3437; }

.bank {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0.7rem 0 0;
  padding: 0;
  list-style: none;
}
.bank li {
  padding: 0.3rem 0.6rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--bone);
  font-family: var(--mono);
  font-size: 0.78rem;
  letter-spacing: 0.02em;
}

table.receipts {
  width: 100%;
  margin-top: 0.4rem;
  border-collapse: collapse;
  font-size: 0.86rem;
}
table.receipts th,
table.receipts td {
  padding: 0.34rem 0.3rem;
  border-bottom: 1px solid var(--line);
  text-align: right;
  font-weight: 400;
}
table.receipts thead th {
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}
table.receipts thead th:nth-child(2) { text-align: left; }
table.receipts td.drams, table.receipts td:nth-child(3) { font-family: var(--mono); }
table.receipts td:nth-child(3),
table.receipts td:nth-child(4) { font-family: var(--mono); white-space: nowrap; }
table.receipts tbody th { text-align: left; }
.riddle {
  margin: 1.1rem auto 0;
  max-width: 38ch;
  text-align: center;
  font-family: var(--serif);
  font-size: 1.06rem;
  font-style: italic;
  line-height: 1.75;
  color: #2f3437;
}
.riddle span { display: block; }
.riddle span:last-child { margin-top: 0.5rem; font-style: normal; }

.gloss {
  margin: 1.1rem 0 0;
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--muted);
}

.potion { display: block; font-weight: 500; }
.flavour {
  display: block;
  margin-top: 0.15rem;
  font-size: 0.74rem;
  font-style: italic;
  color: var(--muted);
}

table.receipts .stamp {
  width: 1.7rem;
  text-align: center;
  font-family: var(--mono);
  font-weight: 600;
  color: var(--ink);
}

form { margin-top: 1.4rem; }

label {
  display: block;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}

.row { display: flex; gap: 0.6rem; margin-top: 0.5rem; }

input[type="text"] {
  flex: 1;
  min-width: 0;
  padding: 0.7rem 0.8rem;
  border: 1px solid #dcd9d2;
  border-radius: 6px;
  background: var(--bone);
  color: var(--ink);
  font-family: var(--mono);
  font-size: 1rem;
}
input[type="text"]:focus {
  outline: none;
  border-color: var(--ink);
  background: var(--surface);
}

button {
  padding: 0.7rem 1.1rem;
  border: 0;
  border-radius: 6px;
  background: var(--ink);
  color: #fff;
  font-family: var(--sans);
  font-size: 0.95rem;
  cursor: pointer;
}
button:hover { background: #333; }
button:active { transform: scale(0.98); }

.status {
  min-height: 1.4rem;
  margin: 0.7rem 0 0;
  font-size: 0.86rem;
  line-height: 1.5;
  color: var(--muted);
}
.status[data-state="error"] { color: #9f2f2d; }

.ticket {
  margin: 2rem 0 0;
  padding: clamp(1.6rem, 6vw, 2.5rem);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  text-align: center;
}
.ticket[hidden] { display: none; }
.text:empty { display: none; }
.text {
  margin: 0 auto 1.4rem;
  max-width: 30ch;
  font-family: var(--serif);
  font-size: 1.15rem;
  line-height: 1.5;
}
.qr:empty { display: none; }
.qr { width: min(15rem, 62vw); margin: 0 auto; }
.qr img { display: block; width: 100%; height: auto; }
.code {
  margin: 1.5rem 0 0;
  font-family: var(--mono);
  font-size: 1.05rem;
  letter-spacing: 0.14em;
}
.note {
  margin: 0.8rem auto 0;
  max-width: 28ch;
  font-size: 0.82rem;
  line-height: 1.55;
  color: var(--muted);
}

.meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem 1.1rem;
  margin: 2rem 0 0;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}
.meta span + span::before { content: "·"; margin-right: 1.1rem; }

.foot { margin: 2rem 0 0; font-size: 0.86rem; line-height: 1.65; color: var(--muted); }

.notice {
  margin: 2rem 0 0;
  padding: 0.72rem 0.9rem;
  background: var(--note-bg);
  color: var(--note-ink);
  border-radius: 6px;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
}

.rise {
  animation: rise 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(var(--i, 0) * 90ms);
}
@keyframes rise { from { opacity: 0; transform: translateY(12px); } }
@media (prefers-reduced-motion: reduce) { .rise { animation: none; } }
</style>
</head>
<body>
<main class="wrap">
  <header>
    <p class="eyebrow rise" style="--i:0">{{ page.title }}</p>
    <h1 class="rise" style="--i:0">{{ gift.headline }}</h1>
    <p class="lead rise" style="--i:1">{{ gift.lead }}</p>
  </header>

  <section class="puzzle rise" style="--i:2">
    <h2 class="step"><span>I</span> Notatki bez nazw</h2>
    <ol class="clues">
      {% for clue in puzzle.clues %}
      <li><span class="num">{{ loop.index }}</span><span class="clue">{{ clue.text }}</span></li>
      {% endfor %}
    </ol>

    <h2 class="step"><span>II</span> Co mówi mistrz eliksirów</h2>
    <div class="riddle">
      {% for line in riddle %}<span>{{ line }}</span>
      {% endfor %}
    </div>

    <h2 class="step"><span>III</span> Zaklęcia do wyboru</h2>
    <ul class="bank">
      {% for spell in puzzle.bank %}<li>{{ spell }}</li>{% endfor %}
    </ul>

    <form id="unlock" autocomplete="off" novalidate>
      <label for="answer">Słowo z pierwszych liter</label>
      <div class="row">
        <input id="answer" name="answer" type="text" placeholder="{{ puzzle.word | length }} liter"
               spellcheck="false" autocapitalize="off" required>
        <button type="submit">Otwórz</button>
      </div>
      <p class="status" id="status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <section class="ticket" id="ticket" hidden aria-live="polite">
    <p class="text" id="text"></p>
    <div class="qr" id="qr"></div>
    <p class="code" id="code"></p>
    <p class="note" id="note"></p>
  </section>

  <p class="meta rise" style="--i:3">
    {% for item in gift.meta %}<span>{{ item }}</span>{% endfor %}
  </p>

  <p class="foot rise" style="--i:4">
    Rezerwacja online: <a href="{{ voucher.redeem_url }}" rel="noreferrer">lock.me</a>.
    Kod jest jednorazowy.
  </p>

  {% if page.test_mode %}
  <p class="notice rise" style="--i:5">Wersja testowa — kupon jest zastępczy</p>
  {% endif %}
</main>

<noscript>
  <p style="max-width:34rem;margin:0 auto 3rem;padding:0 1.5rem;color:#787774">
    Kupon odszyfrowuje się w przeglądarce, więc bez JavaScriptu się nie pokaże.
  </p>
</noscript>

<script type="application/json" id="box">{{ box | tojson }}</script>
<script>
{{ unlock_js | safe }}

(() => {
  const box = JSON.parse(document.getElementById("box").textContent);
  const form = document.getElementById("unlock");
  const input = document.getElementById("answer");
  const status = document.getElementById("status");
  const ticket = document.getElementById("ticket");

  const say = (text, state) => {
    status.textContent = text;
    if (state) status.dataset.state = state;
    else delete status.dataset.state;
  };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    say("Sprawdzam…");
    const payload = await presentUnlock.unlock(input.value, box);

    if (!payload) {
      say("Nie to. Policz jeszcze raz: dom, który wygrywa medianą, i reszta z dzielenia.", "error");
      input.select();
      return;
    }

    // Payload jest strukturą, nie jednym obrazkiem: dziś {code, png, note},
    // jutro np. {text: "półka z książkami, tom trzeci"} — bez zmiany mechaniki.
    if (payload.png) {
      const image = document.createElement("img");
      image.alt = "Kod QR kuponu";
      image.src = "data:image/png;base64," + payload.png;
      document.getElementById("qr").replaceChildren(image);
    }
    if (payload.code) document.getElementById("code").textContent = payload.code;
    if (payload.note) document.getElementById("note").textContent = payload.note;
    if (payload.text) document.getElementById("text").textContent = payload.text;

    form.hidden = true;
    ticket.hidden = false;
    say("");
    ticket.scrollIntoView({ behavior: "smooth", block: "center" });
  });
})();
</script>
</body>
</html>
